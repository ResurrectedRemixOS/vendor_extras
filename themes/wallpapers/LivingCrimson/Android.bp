android_app {
    name: "LivingCrimson",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    // system_current: the always-on display callback is a system API.
    sdk_version: "system_current",
    certificate: "platform",
    product_specific: true,
}
