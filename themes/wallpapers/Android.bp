android_library {
    name: "RRWallpapers-res",
    manifest: "AndroidManifest.library.xml",
    resource_dirs: ["wallpaper-res"],
    sdk_version: "current",
}

android_app {
    name: "RRWallpapers",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["androidx.cardview_cardview"],
    sdk_version: "current",
    certificate: "platform",
    product_specific: true,
}
